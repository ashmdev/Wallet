# VeloxLedger Configuration
# Copy this file to .env and adjust values

# Server Configuration
VELOX__SERVER__HOST=0.0.0.0
VELOX__SERVER__PORT=50051
VELOX__SERVER__GRPC_MAX_MESSAGE_SIZE=4194304

# Database Configuration
VELOX__DATABASE__URL=postgres://veloxledger:password@localhost:5432/veloxledger
VELOX__DATABASE__MAX_CONNECTIONS=100
VELOX__DATABASE__MIN_CONNECTIONS=10
VELOX__DATABASE__ACQUIRE_TIMEOUT_SECS=30
VELOX__DATABASE__IDLE_TIMEOUT_SECS=600
VELOX__DATABASE__MAX_LIFETIME_SECS=1800

# Webhook Configuration
VELOX__WEBHOOK__ENABLED=false
VELOX__WEBHOOK__QUEUE_SIZE=10000
VELOX__WEBHOOK__TIMEOUT_SECS=30
VELOX__WEBHOOK__MAX_RETRIES=5
VELOX__WEBHOOK__ENDPOINT_URL=https://your-webhook-endpoint.com/events

# Run migrations on startup (set to 'true' in development)
VELOX__RUN_MIGRATIONS=false

# Logging
RUST_LOG=info,sqlx::query=warn
